# Copy to .env at repository root. This login is for local development only.
# Use Java properties syntax: KEY=value (no shell export or surrounding quotes).
DB_USERNAME=sa
DB_PASSWORD=
USER_DB_URL=jdbc:sqlserver://localhost:11433;databaseName=kanban_user_db;encrypt=true;trustServerCertificate=true
# Set the same non-empty secret for user-service and the calling service.
INTERNAL_SERVICE_TOKEN=

# Gateway authentication (shared issuer and local Redis Account snapshot).
USER_JWT_ISSUER=dev-platform-user-service
REDIS_HOST=localhost
REDIS_PORT=6379
GATEWAY_UPSTREAM_USER=http://localhost:8081

# Other services can override their SQL Server URLs when needed.
# BOARD_DB_URL=jdbc:sqlserver://localhost;instanceName=SQLEXPRESS;databaseName=kanban_board_db;encrypt=true;trustServerCertificate=true
# TASK_DB_URL=jdbc:sqlserver://localhost;instanceName=SQLEXPRESS;databaseName=kanban_task_db;encrypt=true;trustServerCertificate=true
# NOTIFICATION_DB_URL=jdbc:sqlserver://localhost;instanceName=SQLEXPRESS;databaseName=kanban_notification_db;encrypt=true;trustServerCertificate=true
