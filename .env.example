# Copy to .env at repository root once; keep your existing .env when updating.
# Local development only. Never commit .env or real credentials.
# Java properties syntax: KEY=value; no export, surrounding quotes or inline comments.
# Types/examples are on the preceding comment line, not part of the value.

# SQL login: string; example: sa. Password: your SQL Server login password.
# Docker user-sqlserver requires a password meeting SQL Server complexity rules.
DB_USERNAME=sa
DB_PASSWORD=
# JDBC URLs (strings). Change instanceName=PHUC to your local SQL Server instance.
# Optional Docker User DB: jdbc:sqlserver://localhost:11433;databaseName=kanban_user_db;encrypt=true;trustServerCertificate=true
USER_DB_URL=jdbc:sqlserver://localhost;instanceName=PHUC;databaseName=kanban_user_db;encrypt=true;trustServerCertificate=true
BOARD_DB_URL=jdbc:sqlserver://localhost;instanceName=PHUC;databaseName=kanban_board_db;encrypt=true;trustServerCertificate=true
TASK_DB_URL=jdbc:sqlserver://localhost;instanceName=PHUC;databaseName=kanban_task_db;encrypt=true;trustServerCertificate=true
NOTIFICATION_DB_URL=jdbc:sqlserver://localhost;instanceName=PHUC;databaseName=kanban_notification_db;encrypt=true;trustServerCertificate=true

# Secrets: independent random strings, not numbers or UUIDs. Required: fill both.
# Generate each separately with: openssl rand -hex 32
# Format example only: 64 hexadecimal characters (0-9, a-f); do not use a fixed sample.
# INTERNAL_SERVICE_TOKEN must match across services making/receiving internal calls.
INTERNAL_SERVICE_TOKEN=
# Board currently requires this value at startup; Gateway HMAC signing and
# Board signature verification are not active in the current implementation.
GATEWAY_HMAC_SECRET=

# JWT issuer: fixed string shared by User and Gateway, not a secret.
USER_JWT_ISSUER=dev-platform-user-service
# Upstream URL (string): scheme + host + numeric port.
GATEWAY_UPSTREAM_USER=http://localhost:8081
# Duration (ISO-8601): PT30S = 30 seconds. Origins: comma-separated URL strings.
GATEWAY_WS_TICKET_TTL=PT30S
GATEWAY_WS_ALLOWED_ORIGINS=http://localhost:5173

# Redis host (string, without scheme) and TCP port (integer, 1-65535).
# Local Compose Redis has no username/password; it is bound to loopback.
REDIS_HOST=localhost
REDIS_PORT=6379

# RabbitMQ host (string) and TCP ports (integers, 1-65535).
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
# Local development credentials (strings), shared by Compose and the services.
# Use simple letters/digits for compatibility with Compose and Java properties.
RABBITMQ_USERNAME=devplatform
RABBITMQ_PASSWORD=devplatform

# Integration flags: booleans, exactly true or false. Service defaults are false.
# This example enables the full local stack; requires initialized SQL DBs,
# RabbitMQ, Redis, internal secrets and all five backend processes.
# Rabbit exchange/consumer factory, producer relay and service consumers.
MESSAGING_ENABLED=true
OUTBOX_RELAY_ENABLED=true
MESSAGING_CONSUMERS_ENABLED=true
# Redis snapshot workers. Without snapshots, protected requests fail closed.
USER_AUTH_SNAPSHOT_SYNC_ENABLED=true
PROJECT_AUTH_SNAPSHOT_SYNC_ENABLED=true
# Task HTTP identity and backend WebSocket gates (not a web client implementation).
# Keep services on loopback when accepting Gateway-injected identity locally.
TASK_TRUSTED_GATEWAY_IDENTITY_ENABLED=true
TASK_BOARD_PROJECT_LOOKUP_READY=true
TASK_GATEWAY_WEBSOCKET_PROXY_READY=true
TASK_BOARD_WEBSOCKET_ENABLED=true
# Task membership cleanup listener/topology and durable cleanup worker.
MEMBER_ASSIGNMENT_CLEANUP_RETRY_DLQ_READY=true
MEMBER_ASSIGNMENT_CLEANUP_ENABLED=true
# Legacy internal Notification HTTP endpoint; Rabbit consumers do not need this.
INTERNAL_NOTIFICATIONS_ENABLED=false

# Bind address (IP string), not a URL. Local testing only.
server.address=127.0.0.1
# Optional timing examples: milliseconds = positive integer; duration = ISO-8601.
# OUTBOX_RELAY_FIXED_DELAY_MS=1000
# OUTBOX_RELAY_RETRY_DELAY=PT5S
# OUTBOX_RELAY_CONFIRM_TIMEOUT=PT5S
