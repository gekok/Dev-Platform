        <mxCell id="18" value="&lt;b&gt;08.&lt;/b&gt; APPLIED / ALREADY_CURRENT / SUPERSEDED" style="edgeStyle=none;html=1;rounded=0;strokeColor=#7a8793;strokeWidth=1.4;dashed=1;endArrow=open;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;align=center;verticalAlign=middle;" edge="1" parent="1">
