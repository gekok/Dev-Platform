        </mxCell>
        <mxCell id="3" value="Kỳ 1 only invites existing Accounts. PENDING grants no access; Accept alone creates Membership MEMBER." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#52677d;whiteSpace=wrap;" vertex="1" parent="1">
