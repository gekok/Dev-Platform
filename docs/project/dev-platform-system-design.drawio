        <mxCell id="10" value="&lt;b&gt;01.&lt;/b&gt; One TX: business mutation + outbox_events row" style="edgeStyle=none;html=1;rounded=0;strokeColor=#456b8a;strokeWidth=1.4;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;align=center;verticalAlign=middle;" edge="1" parent="1">
