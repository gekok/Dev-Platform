            <mxPoint x="1004" y="293" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="13" value="&lt;b&gt;04.&lt;/b&gt; Publisher Confirm + Publisher Return (not Consumer ACK)" style="edgeStyle=none;html=1;rounded=0;strokeColor=#7a8793;strokeWidth=1.4;dashed=1;endArrow=open;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;align=center;verticalAlign=middle;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1004" y="347" as="sourcePoint" />
            <mxPoint x="716" y="347" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="14" value="&lt;b&gt;05.&lt;/b&gt; Confirm and no Return → SENT; unknown/failure → retry" style="edgeStyle=none;html=1;rounded=0;strokeColor=#c89b2c;strokeWidth=1.4;dashed=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;align=center;verticalAlign=middle;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="716" y="401" as="sourcePoint" />
            <mxPoint x="428" y="401" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="15" value="&lt;b&gt;06.&lt;/b&gt; Retry same eventId, aggregateVersion, payload; broker may have accepted" style="edgeStyle=none;html=1;rounded=0;strokeColor=#2e8b57;strokeWidth=1.4;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;align=center;verticalAlign=middle;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="716" y="455" as="sourcePoint" />
            <mxPoint x="1004" y="455" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="16" value="&lt;b&gt;07.&lt;/b&gt; Delivery may be duplicate or redelivery after lost ACK" style="edgeStyle=none;html=1;rounded=0;strokeColor=#456b8a;strokeWidth=1.4;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;align=center;verticalAlign=middle;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1004" y="509" as="sourcePoint" />
            <mxPoint x="1292" y="509" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="17" value="&lt;b&gt;08.&lt;/b&gt; TX: Inbox(consumerName,eventId) + business state or durable job" style="edgeStyle=none;html=1;rounded=0;strokeColor=#456b8a;strokeWidth=1.4;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;align=center;verticalAlign=middle;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1292" y="563" as="sourcePoint" />
            <mxPoint x="1580" y="563" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="18" value="&lt;b&gt;09.&lt;/b&gt; Commit before ACK; existing Inbox key skips side effect" style="edgeStyle=none;html=1;rounded=0;strokeColor=#7a8793;strokeWidth=1.4;dashed=1;endArrow=open;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;align=center;verticalAlign=middle;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1580" y="617" as="sourcePoint" />
            <mxPoint x="1292" y="617" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="19" value="&lt;b&gt;10.&lt;/b&gt; ACK only after commit; lost ACK → same event redelivered" style="edgeStyle=none;html=1;rounded=0;strokeColor=#7a8793;strokeWidth=1.4;dashed=1;endArrow=open;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;align=center;verticalAlign=middle;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1292" y="671" as="sourcePoint" />
            <mxPoint x="1004" y="671" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="2" value="&lt;b&gt;RabbitMQ reliability — Outbox, Confirm/Return, Inbox, ACK&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=23;fontStyle=1;fontColor=#17365d;" vertex="1" parent="1">
          <mxGeometry x="38" y="18" width="1644" height="42" as="geometry" />
        </mxCell>
        <mxCell id="3" value="At-least-once delivery; eventId, aggregateVersion and operationId address different concerns." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#52677d;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="62" width="1640" height="44" as="geometry" />
        </mxCell>
        <mxCell id="20" value="&lt;b&gt;Producer app&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;strokeColor=#6c8ebf;fillColor=#f5f8fb;" vertex="1" parent="1">
          <mxGeometry x="40" y="110" width="200" height="54" as="geometry" />
        </mxCell>
        <mxCell id="21" value="&lt;b&gt;Producer DB&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;strokeColor=#6c8ebf;fillColor=#f5f8fb;" vertex="1" parent="1">
          <mxGeometry x="328" y="110" width="200" height="54" as="geometry" />
        </mxCell>
        <mxCell id="22" value="&lt;b&gt;Outbox Relay&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;strokeColor=#6c8ebf;fillColor=#f5f8fb;" vertex="1" parent="1">
          <mxGeometry x="616" y="110" width="200" height="54" as="geometry" />
        </mxCell>
        <mxCell id="23" value="&lt;b&gt;RabbitMQ&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;strokeColor=#6c8ebf;fillColor=#f5f8fb;" vertex="1" parent="1">
          <mxGeometry x="904" y="110" width="200" height="54" as="geometry" />
        </mxCell>
        <mxCell id="24" value="&lt;b&gt;Consumer&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;strokeColor=#6c8ebf;fillColor=#f5f8fb;" vertex="1" parent="1">
          <mxGeometry x="1192" y="110" width="200" height="54" as="geometry" />
        </mxCell>
        <mxCell id="25" value="&lt;b&gt;Consumer DB&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;strokeColor=#6c8ebf;fillColor=#f5f8fb;" vertex="1" parent="1">
          <mxGeometry x="1480" y="110" width="200" height="54" as="geometry" />
        </mxCell>
        <mxCell id="26" value="• Envelope: eventId, eventType, schemaVersion, aggregateType, aggregateId, aggregateVersion, occurredAt, payload. Wire eventType is lowercase dotted.&lt;br/&gt;• eventId deduplicates one exact event per consumer. aggregateVersion detects stale/order/gaps; do not blindly discard every lower version. Retry does not increment version.&lt;br/&gt;• operationId correlates multi-event work; completion is a new eventId. New event IDs for repeat commands may need business idempotency key.&lt;br/&gt;• Queue/binding/listeners are incomplete; retry limits, DLQ, retention and alerts remain open." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=9;fontSize=11;strokeColor=#d6b656;fillColor=#fff2cc;" vertex="1" parent="1">
          <mxGeometry x="40" y="749" width="1640" height="202" as="geometry" />
        </mxCell>
        <mxCell id="27" value="Runtime/JPA skeleton" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=10;strokeColor=#6c8ebf;fillColor=#dae8fc;" vertex="1" parent="1">
          <mxGeometry x="40" y="993" width="393" height="28" as="geometry" />
        </mxCell>
        <mxCell id="28" value="Kỳ 1 target" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=10;strokeColor=#82b366;fillColor=#d5e8d4;" vertex="1" parent="1">
          <mxGeometry x="445" y="993" width="393" height="28" as="geometry" />
        </mxCell>
        <mxCell id="29" value="TODO / open" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=10;strokeColor=#d6b656;fillColor=#fff2cc;" vertex="1" parent="1">
          <mxGeometry x="850" y="993" width="393" height="28" as="geometry" />
        </mxCell>
        <mxCell id="30" value="Kỳ 2 deferred" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=10;strokeColor=#b85450;fillColor=#f4cccc;" vertex="1" parent="1">
          <mxGeometry x="1255" y="993" width="393" height="28" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
