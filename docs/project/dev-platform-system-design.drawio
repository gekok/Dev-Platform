            <mxPoint x="716" y="239" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="12" value="&lt;b&gt;03.&lt;/b&gt; Publish persistent message; mandatory=true" style="edgeStyle=none;html=1;rounded=0;strokeColor=#456b8a;strokeWidth=1.4;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;align=center;verticalAlign=middle;" edge="1" parent="1">
