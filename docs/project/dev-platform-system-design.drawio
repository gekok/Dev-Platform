        <mxCell id="2" value="&lt;b&gt;Invitation → Accept / Reject / Cancel → Membership&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=23;fontStyle=1;fontColor=#17365d;" vertex="1" parent="1">
