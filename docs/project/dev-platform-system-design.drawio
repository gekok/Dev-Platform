        </mxCell>
        <mxCell id="17" value="&lt;b&gt;07.&lt;/b&gt; Apply current snapshot with authVersion CAS; stale cannot overwrite" style="edgeStyle=none;html=1;rounded=0;strokeColor=#c89b2c;strokeWidth=1.4;dashed=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;align=center;verticalAlign=middle;" edge="1" parent="1">
