        </mxCell>
        <mxCell id="3" value="DB + Outbox + durable snapshot job commit trước; API không đợi assignment cleanup. Pending Redis sync → 202 + operation handle." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#52677d;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="62" width="1910" height="44" as="geometry" />
