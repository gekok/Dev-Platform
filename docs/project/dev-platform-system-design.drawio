  <diagram id="page-02" name="01 - Role matrix">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="850" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="2" value="&lt;b&gt;Role matrix — System Admin khác Project Owner&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=23;fontStyle=1;fontColor=#17365d;" vertex="1" parent="1">
          <mxGeometry x="38" y="18" width="1424" height="42" as="geometry" />
        </mxCell>
        <mxCell id="3" value="SYSTEM_ADMIN thuộc user_db; OWNER/MEMBER thuộc board_db. Admin role tự nó không cấp quyền Project." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#52677d;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="62" width="1420" height="44" as="geometry" />
        </mxCell>
        <mxCell id="4" value="&lt;div style=&#39;font-size:16px;font-weight:bold;&#39;&gt;System Admin&lt;/div&gt;&lt;hr/&gt;&lt;div style=&#39;font-size:12px;line-height:1.4;&#39;&gt;&lt;b&gt;Đã chốt&lt;/b&gt;&lt;br/&gt;• Tạo tài khoản hệ thống&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Còn mở&lt;/b&gt;&lt;br/&gt;• Quyền/API cấp, thu hồi SystemRoles&lt;br/&gt;• Bootstrap Admin đầu tiên&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Không được chỉ vì là Admin&lt;/b&gt;&lt;br/&gt;• Xem/sửa Project&lt;br/&gt;• Mời/gỡ Member&lt;br/&gt;• Tạo Board/Card/comment&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontSize=12;strokeColor=#6c8ebf;fillColor=#dae8fc;" vertex="1" parent="1">
          <mxGeometry x="55" y="160" width="430" height="395" as="geometry" />
        </mxCell>
        <mxCell id="5" value="&lt;div style=&#39;font-size:16px;font-weight:bold;&#39;&gt;Owner&lt;/div&gt;&lt;hr/&gt;&lt;div style=&#39;font-size:12px;line-height:1.4;&#39;&gt;&lt;b&gt;Owner duy nhất trong Project&lt;/b&gt;&lt;br/&gt;• Tạo Project; người tạo thành Owner&lt;br/&gt;• Mời/gỡ Member&lt;br/&gt;• Tạo Board; quản lý lifecycle&lt;br/&gt;• Tạo Column/Card, move, assign, comment&lt;br/&gt;• Không thể tự rời; có thể CANCELLED Project&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontSize=12;strokeColor=#82b366;fillColor=#d5e8d4;" vertex="1" parent="1">
          <mxGeometry x="530" y="160" width="430" height="395" as="geometry" />
        </mxCell>
        <mxCell id="6" value="&lt;div style=&#39;font-size:16px;font-weight:bold;&#39;&gt;Member&lt;/div&gt;&lt;hr/&gt;&lt;div style=&#39;font-size:12px;line-height:1.4;&#39;&gt;&lt;b&gt;Sau khi Accept Invitation&lt;/b&gt;&lt;br/&gt;• Tạo Column/Card, move, assign, comment&lt;br/&gt;• Tự rời Project&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Không được&lt;/b&gt;&lt;br/&gt;• Mời/gỡ người khác&lt;br/&gt;• Tạo Board hoặc quản lý lifecycle&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontSize=12;strokeColor=#82b366;fillColor=#d5e8d4;" vertex="1" parent="1">
          <mxGeometry x="1005" y="160" width="430" height="395" as="geometry" />
        </mxCell>
        <mxCell id="7" value="&lt;b&gt;Còn mở:&lt;/b&gt; Một Account có thể vừa SYSTEM_ADMIN vừa tham gia Project hay không; bootstrap Admin đầu tiên; API cấp/thu hồi system role. Quyền Project đến từ Membership, không từ claim do client gửi." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=9;fontSize=11;strokeColor=#d6b656;fillColor=#fff2cc;" vertex="1" parent="1">
          <mxGeometry x="55" y="600" width="1390" height="100" as="geometry" />
        </mxCell>
