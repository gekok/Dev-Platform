        <mxCell id="15" value="&lt;b&gt;06.&lt;/b&gt; Lock Project/User assignment writes; process durable batches" style="edgeStyle=none;html=1;rounded=0;strokeColor=#456b8a;strokeWidth=1.4;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;align=center;verticalAlign=middle;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1292" y="455" as="sourcePoint" />
            <mxPoint x="1004" y="455" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="16" value="&lt;b&gt;07.&lt;/b&gt; Delete only projectId + userId + membershipVersion + boardIds" style="edgeStyle=none;html=1;rounded=0;strokeColor=#456b8a;strokeWidth=1.4;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;align=center;verticalAlign=middle;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1292" y="509" as="sourcePoint" />
            <mxPoint x="1004" y="509" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="17" value="&lt;b&gt;08.&lt;/b&gt; Checkpoint last_processed_card_id; retry batch idempotently" style="edgeStyle=none;html=1;rounded=0;strokeColor=#456b8a;strokeWidth=1.4;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;align=center;verticalAlign=middle;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1292" y="563" as="sourcePoint" />
            <mxPoint x="1004" y="563" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="18" value="&lt;b&gt;09.&lt;/b&gt; Outbox completion: new eventId; same operationId/generation/source version" style="edgeStyle=none;html=1;rounded=0;strokeColor=#2e8b57;strokeWidth=1.4;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;align=center;verticalAlign=middle;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1292" y="617" as="sourcePoint" />
            <mxPoint x="140" y="617" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="19" value="&lt;b&gt;10.&lt;/b&gt; Record cleanup result; does not affect revoke completion" style="edgeStyle=none;html=1;rounded=0;strokeColor=#456b8a;strokeWidth=1.4;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;align=center;verticalAlign=middle;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="140" y="671" as="sourcePoint" />
            <mxPoint x="1580" y="671" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="2" value="&lt;b&gt;Member rời Project — Inbox, fence, generation và cleanup nền&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=23;fontStyle=1;fontColor=#17365d;" vertex="1" parent="1">
          <mxGeometry x="38" y="18" width="1644" height="42" as="geometry" />
        </mxCell>
        <mxCell id="3" value="Cleanup chỉ tác động assignment của membershipVersion bị revoke, tránh xóa assignment sau khi rejoin." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#52677d;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="62" width="1640" height="44" as="geometry" />
        </mxCell>
        <mxCell id="20" value="&lt;b&gt;board-service&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;strokeColor=#6c8ebf;fillColor=#f5f8fb;" vertex="1" parent="1">
          <mxGeometry x="40" y="110" width="200" height="54" as="geometry" />
        </mxCell>
        <mxCell id="21" value="&lt;b&gt;RabbitMQ&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;strokeColor=#6c8ebf;fillColor=#f5f8fb;" vertex="1" parent="1">
          <mxGeometry x="328" y="110" width="200" height="54" as="geometry" />
        </mxCell>
        <mxCell id="22" value="&lt;b&gt;task-service consumer&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;strokeColor=#6c8ebf;fillColor=#f5f8fb;" vertex="1" parent="1">
          <mxGeometry x="616" y="110" width="200" height="54" as="geometry" />
        </mxCell>
        <mxCell id="23" value="&lt;b&gt;task_db&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;strokeColor=#6c8ebf;fillColor=#f5f8fb;" vertex="1" parent="1">
          <mxGeometry x="904" y="110" width="200" height="54" as="geometry" />
        </mxCell>
        <mxCell id="24" value="&lt;b&gt;cleanup worker&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;strokeColor=#6c8ebf;fillColor=#f5f8fb;" vertex="1" parent="1">
          <mxGeometry x="1192" y="110" width="200" height="54" as="geometry" />
        </mxCell>
        <mxCell id="25" value="&lt;b&gt;board-service completion&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;strokeColor=#6c8ebf;fillColor=#f5f8fb;" vertex="1" parent="1">
          <mxGeometry x="1480" y="110" width="200" height="54" as="geometry" />
        </mxCell>
        <mxCell id="26" value="• Duplicate eventId is skipped by Inbox. Inbox + fence + job commit in task_db before ACK.&lt;br/&gt;• membershipVersion is a membership generation, held through revoke and incremented on rejoin. sourceAggregateVersion preserves request event version.&lt;br/&gt;• Comments/attribution remain. This is not Account deletion or Project cascade." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=9;fontSize=11;strokeColor=#d6b656;fillColor=#fff2cc;" vertex="1" parent="1">
          <mxGeometry x="40" y="749" width="1640" height="156" as="geometry" />
        </mxCell>
        <mxCell id="27" value="Runtime/JPA skeleton" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=10;strokeColor=#6c8ebf;fillColor=#dae8fc;" vertex="1" parent="1">
          <mxGeometry x="40" y="947" width="393" height="28" as="geometry" />
        </mxCell>
        <mxCell id="28" value="Kỳ 1 target" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=10;strokeColor=#82b366;fillColor=#d5e8d4;" vertex="1" parent="1">
          <mxGeometry x="445" y="947" width="393" height="28" as="geometry" />
        </mxCell>
        <mxCell id="29" value="TODO / open" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=10;strokeColor=#d6b656;fillColor=#fff2cc;" vertex="1" parent="1">
          <mxGeometry x="850" y="947" width="393" height="28" as="geometry" />
