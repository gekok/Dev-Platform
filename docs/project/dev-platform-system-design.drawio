        <mxCell id="22" value="&lt;b&gt;Owner / Member&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;strokeColor=#6c8ebf;fillColor=#f5f8fb;" vertex="1" parent="1">
