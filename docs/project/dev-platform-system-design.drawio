        <mxCell id="30" value="Kỳ 2 deferred" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=10;strokeColor=#b85450;fillColor=#f4cccc;" vertex="1" parent="1">
