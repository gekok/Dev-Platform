          <mxGeometry x="895" y="110" width="200" height="54" as="geometry" />
        </mxCell>
        <mxCell id="26" value="&lt;b&gt;Redis sync worker&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;strokeColor=#6c8ebf;fillColor=#f5f8fb;" vertex="1" parent="1">
